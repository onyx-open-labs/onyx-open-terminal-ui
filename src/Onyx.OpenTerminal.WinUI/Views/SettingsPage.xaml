<Page
    x:Class="Onyx.OpenTerminal.WinUI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="16" MaxWidth="640" HorizontalAlignment="Left">
        <TextBox x:Name="TerminalUrlBox" Header="Terminal URL"
                 MinWidth="320" PlaceholderText="https://example.com"
                 Description="Use about:blank or leave empty to disable Terminal View." />
        <TextBlock Text="Changes apply the next time you open Terminal View."
                   TextWrapping="Wrap" />
        <Button Content="Save" Click="Save_Click" />
        <InfoBar x:Name="SaveResult" IsOpen="False" IsClosable="True" />
    </StackPanel>
</Page>
