<Page
    x:Class="Onyx.OpenTerminal.WinUI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
        <Grid x:Name="SettingsLayout" MaxWidth="1064" Margin="12,24,12,36">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="Compact">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="UrlEditor.(Grid.Row)" Value="1" />
                            <Setter Target="UrlEditor.(Grid.Column)" Value="0" />
                            <Setter Target="UrlEditor.(Grid.ColumnSpan)" Value="2" />
                            <Setter Target="UrlEditor.Margin" Value="0,16,0,0" />
                            <Setter Target="UrlEditor.Width" Value="NaN" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Wide">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1100" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="UrlEditor.(Grid.Row)" Value="0" />
                            <Setter Target="UrlEditor.(Grid.Column)" Value="1" />
                            <Setter Target="UrlEditor.(Grid.ColumnSpan)" Value="1" />
                            <Setter Target="UrlEditor.Margin" Value="32,0,0,0" />
                            <Setter Target="UrlEditor.Width" Value="400" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <StackPanel Spacing="0">
                <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}"
                           AutomationProperties.HeadingLevel="Level1" Margin="0,0,0,30" />
                <TextBlock Text="Terminal" Style="{StaticResource BodyStrongTextBlockStyle}"
                           AutomationProperties.HeadingLevel="Level2" Margin="1,0,0,8" />
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="16" MinHeight="72">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="20" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <SymbolIcon Symbol="Globe" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="Terminal URL" TextWrapping="Wrap" />
                                <TextBlock Text="Choose the website to open in Terminal View."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="UrlEditor" Grid.Row="1" Grid.ColumnSpan="2"
                              Margin="0,16,0,0" ColumnSpacing="8" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TerminalUrlBox" PlaceholderText="https://example.com"
                                     AutomationProperties.Name="Terminal URL"
                                     VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Save" Click="Save_Click"
                                    MinWidth="80" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Border>
                <TextBlock Text="Use about:blank or leave empty to disable Terminal View. Changes apply the next time you open it."
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" Margin="16,8,16,0" />
                <InfoBar x:Name="SaveResult" IsOpen="False" IsClosable="True" Margin="0,16,0,0" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
