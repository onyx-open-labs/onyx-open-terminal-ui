<Window
    x:Class="Onyx.OpenTerminal.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Onyx Open Terminal">
    <NavigationView x:Name="Navigation"
                    PaneDisplayMode="Left"
                    IsPaneOpen="True"
                    IsSettingsVisible="False"
                    IsBackButtonVisible="Collapsed"
                    Header="Home"
                    SelectionChanged="Navigation_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="HomeNavigationItem"
                                Content="Home"
                                AutomationProperties.Name="Home">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Home" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <Frame x:Name="ContentFrame"
               Margin="24"
               IsNavigationStackEnabled="False" />
    </NavigationView>
</Window>
